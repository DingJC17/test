# Site
NEXT_PUBLIC_SITE_NAME="AI 自动化工具箱"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_GITHUB_URL="https://github.com/yourname"
NEXT_PUBLIC_CONTACT_WECHAT="your_wechat_id"
NEXT_PUBLIC_CONTACT_EMAIL="your@email.com"
NEXT_PUBLIC_TAGLINE="免费试用文档转表格、Office 文档摘要、评论分析工具"
NEXT_PUBLIC_ENABLE_MOCK_AI="true"

# AI Provider — 可选 "openai" 或 "deepseek"
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
# 如果 AI_PROVIDER=openai 则使用以下：
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
SUPABASE_STORAGE_BUCKET="trial-uploads"

# Upload and trial limits
MAX_FILE_SIZE_MB="5"
MAX_TEXT_INPUT_CHARS="12000"
MAX_DAILY_TRIALS_PER_TOOL="5"

# Admin
ADMIN_PASSWORD=""

# Security
IP_HASH_SALT="replace-with-random-secret"
